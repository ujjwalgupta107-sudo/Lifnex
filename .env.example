# Supabase Project Configuration (Staging: jejnuespiiksqfgqwsg)
SUPABASE_URL=https://jejnuespiiksqfgqwsg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_anon_key_here
SUPABASE_SECRET_KEY=sb_secret_service_role_key_here
SUPABASE_JWKS_URL=https://jejnuespiiksqfgqwsg.supabase.co/auth/v1/.well-known/jwks.json

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Application Settings
FLASK_APP=backend.app:create_app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=lifnex-super-secret-session-key-dev-only-change-in-prod
PORT=5000
CORS_ORIGINS=*

# SMTP Email Relay Configuration (Resend: smtp.resend.com)
# For STARTTLS: Port 587, SMTP_USE_TLS=1, SMTP_USE_SSL=0
# For SSL/TLS: Port 465, SMTP_USE_TLS=0, SMTP_USE_SSL=1
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_your_resend_api_key_here
SMTP_FROM=noreply@lifnex.space
SMTP_FROM_NAME=Lifnex Emergency Network
SMTP_USE_TLS=1
SMTP_USE_SSL=0


