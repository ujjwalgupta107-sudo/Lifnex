{
  "version": 2,
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/frontend/dist/assets/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/frontend/dist/static/$1"
    },
    {
      "source": "/((?!api/|static/|assets/).*\\.(?:html|css|js|png|jpg|jpeg|svg|ico|json|woff|woff2|ttf|map))",
      "destination": "/frontend/dist/$1"
    },
    {
      "source": "/((?!api/|static/|assets/).*)",
      "destination": "/frontend/dist/$1.html"
    },
    {
      "source": "/",
      "destination": "/frontend/dist/index.html"
    }
  ]
}
