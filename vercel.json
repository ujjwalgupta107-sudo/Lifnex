{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|static/|assets/).*\\.(?:html|css|js|png|jpg|jpeg|svg|ico|json|woff|woff2|ttf|map|mp4))",
      "destination": "/$1"
    },
    {
      "source": "/((?!api/|static/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
